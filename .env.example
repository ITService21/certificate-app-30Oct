# Server
PORT=4100
NODE_ENV=production

# MySQL 8 (or MariaDB 10.6+)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=certverify
DB_PASSWORD=CHANGE_ME
DB_NAME=certverify

# Long random string (e.g. `openssl rand -hex 48`). The server refuses to start in production without it.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d

# Public https URL of the site. QR codes on generated certificates point here.
PUBLIC_URL=https://verify.example.com

# Only used by `npm run db:seed` (demo data) - never seed demo users in production.
SEED_PASSWORD=Admin@12345
# Enables Settings > "Restore demo dataset". Keep false in production.
ALLOW_DEMO_RESET=false
