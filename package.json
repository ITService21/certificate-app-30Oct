{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "server": "tsx watch server/index.ts",
    "dev:all": "sh -c 'trap \"kill 0\" INT TERM EXIT; tsx watch server/index.ts & bun --bun vite --port=3000 --host=0.0.0.0; wait'",
    "build": "vite build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=server.js",
    "start": "NODE_ENV=production node server.js",
    "preview": "vite preview",
    "db:init": "tsx server/migrate.ts",
    "db:seed": "tsx server/seed-cli.ts",
    "db:reseed": "tsx server/seed-cli.ts --reset",
    "admin:create": "tsx server/create-admin.ts",
    "courses:sync": "tsx server/sync-courses.ts",
    "pdf:regenerate": "tsx server/regenerate-pdfs.ts",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test:api": "node tests/api.test.mjs",
    "test:ui": "node tests/ui.test.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-react": "^6.1.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "pdfjs-dist": "4.10.38",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.16.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
